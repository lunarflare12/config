+procedure TfrmMain.FillResolutions;
+var
+  want: string;
+begin
+  if not Assigned(cboResolution) then Exit;
+  want := Format('%dx%d', [FPrefW, FPrefH]);
+  cboResolution.Items.BeginUpdate;
+  try
+    cboResolution.Items.Clear;
+    cboResolution.Items.Add('3840x2160');
+    cboResolution.Items.Add('1920x1440');
+    cboResolution.Items.Add('1920x1080');
+    cboResolution.Items.Add('1280x960');
+    cboResolution.Items.Add('1280x720');
+    cboResolution.Items.Add('960x540');
+    cboResolution.Items.Add('640x360');
+  finally
+    cboResolution.Items.EndUpdate;
+  end;
+  cboResolution.ItemIndex := cboResolution.Items.IndexOf(want);
+  if cboResolution.ItemIndex < 0 then
+    cboResolution.ItemIndex := cboResolution.Items.IndexOf('1920x1080');
+  if cboResolution.ItemIndex < 0 then
+    cboResolution.ItemIndex := 2;
+end;
+
+function TfrmMain.SelectedWidth: Integer;
+var
+  s: string;
+  x: Integer;
+begin
+  Result := FPrefW;
+  if not Assigned(cboResolution) or (cboResolution.ItemIndex < 0) then Exit;
+  s := cboResolution.Items[cboResolution.ItemIndex];
+  x := Pos('x', s);
+  if x > 1 then
+    Result := StrToIntDef(Copy(s, 1, x - 1), FPrefW);
+end;
+
+function TfrmMain.SelectedHeight: Integer;
+var
+  s: string;
+  x: Integer;
+begin
+  Result := FPrefH;
+  if not Assigned(cboResolution) or (cboResolution.ItemIndex < 0) then Exit;
+  s := cboResolution.Items[cboResolution.ItemIndex];
+  x := Pos('x', s);
+  if x > 0 then
+    Result := StrToIntDef(Copy(s, x + 1, MaxInt), FPrefH);
+end;
+
+procedure TfrmMain.ResolutionChange(Sender: TObject);
+var
+  was: Boolean;
+begin
+  if FUpdating then Exit;
+  FPrefW := SelectedWidth;
+  FPrefH := SelectedHeight;
+  was := Assigned(FCapture) and FCapture.Streaming;
+  if was then
+  begin
+    StopPreview;
+    StartPreview;
+  end;
+  SaveSettings;
+end;
