--- a/thunar/thunar-file.c
+++ b/thunar/thunar-file.c
@@ -3244,13 +3244,28 @@
 gboolean
 thunar_file_is_hidden (const ThunarFile *file)
 {
+  const gchar *name;
+
   _thunar_return_val_if_fail (THUNAR_IS_FILE (file), FALSE);
 
   if (file->info == NULL)
     return FALSE;
 
-  return g_file_info_get_attribute_boolean (file->info, G_FILE_ATTRIBUTE_STANDARD_IS_HIDDEN)
-         || g_file_info_get_attribute_boolean (file->info, G_FILE_ATTRIBUTE_STANDARD_IS_BACKUP);
+  if (g_file_info_get_attribute_boolean (file->info, G_FILE_ATTRIBUTE_STANDARD_IS_HIDDEN)
+      || g_file_info_get_attribute_boolean (file->info, G_FILE_ATTRIBUTE_STANDARD_IS_BACKUP))
+    return TRUE;
+
+  /* gvfs computer:/// always lists GDrives. UDISKS_IGNORE only hides volumes,
+     so the system disk still appears as a second unopenable ".drive" icon
+     next to File System (root.link). USB filesystems show as ".volume". */
+  if (file->gfile != NULL && g_file_has_uri_scheme (file->gfile, "computer"))
+    {
+      name = g_file_info_get_name (file->info);
+      if (name != NULL && g_str_has_suffix (name, ".drive"))
+        return TRUE;
+    }
+
+  return FALSE;
 }
 
 
