+procedure TfrmMain.PreviewPaint(Sender: TObject);
+var
+  r, d: TRect;
+  bw, bh, dw, dh, cw, ch: Integer;
+  sx, sy: Double;
+  msg: string;
+begin
+  if not Assigned(pbPreview) then Exit;
+  r := pbPreview.ClientRect;
+  cw := r.Right - r.Left;
+  ch := r.Bottom - r.Top;
+  if (cw < 2) or (ch < 2) then Exit;
+  try
+    pbPreview.Canvas.Brush.Color := clBlack;
+    pbPreview.Canvas.FillRect(r);
+
+    if Assigned(FPreviewBmp) and (FPreviewBmp.Width > 1) and (FPreviewBmp.Height > 1) then
+    begin
+      bw := FPreviewBmp.Width;
+      bh := FPreviewBmp.Height;
+      sx := cw / bw;
+      sy := ch / bh;
+      if sx < sy then
+      begin
+        dw := cw;
+        dh := Round(bh * sx);
+      end
+      else
+      begin
+        dh := ch;
+        dw := Round(bw * sy);
+      end;
+      if dw < 1 then dw := 1;
+      if dh < 1 then dh := 1;
+      d.Left := r.Left + (cw - dw) div 2;
+      d.Top := r.Top + (ch - dh) div 2;
+      d.Right := d.Left + dw;
+      d.Bottom := d.Top + dh;
+      pbPreview.Canvas.StretchDraw(d, FPreviewBmp);
+      Exit;
+    end;
+
+    pbPreview.Canvas.Font.Color := clSilver;
+    pbPreview.Canvas.Font.Size := 16;
+    if Assigned(FCapture) and FCapture.Streaming then
+      msg := 'Waiting for frames...'
+    else
+      msg := 'Connect the camera, then Start Preview';
+    pbPreview.Canvas.TextOut(r.Left + 24, r.Top + 24, msg);
+  except
   end;
 end;
 
