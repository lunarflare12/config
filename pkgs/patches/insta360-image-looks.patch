+function TfrmMain.DefaultLook(Index: Integer): string;
+begin
+  case Index of
+    0: Result := 'Natural';
+    1: Result := 'Stream';
+    2: Result := 'Soft';
+    3: Result := 'Desk';
+  else
+    Result := 'Look';
+  end;
+end;
+
+procedure TfrmMain.HighlightLook(Index: Integer);
+var
+  i: Integer;
+begin
+  for i := 0 to 3 do
+    if Assigned(btnLook[i]) then
+      if i = Index then
+        btnLook[i].Font.Style := [fsBold]
+      else
+        btnLook[i].Font.Style := [];
+end;
+
+procedure TfrmMain.ApplyLook(Index: Integer);
+var
+  b, c, s, sh, g, wb: LongInt;
+  autoWB, backlight: Boolean;
+begin
+  if not FCam.Connected then Exit;
+
+  autoWB := True;
+  backlight := False;
+  wb := 5600;
+  g := 0;
+  case Index of
+    0: begin // Natural — clean skin, no edge crunch
+         b := 52; c := 54; s := 48; sh := 42;
+       end;
+    1: begin // Stream — a bit more punch for face cam
+         b := 55; c := 58; s := 50; sh := 48;
+         backlight := True;
+       end;
+    2: begin // Soft — warmer, flatter, kinder to skin
+         b := 56; c := 46; s := 44; sh := 32;
+         autoWB := False; wb := 4800;
+       end;
+    3: begin // Desk — readable text / documents
+         b := 50; c := 62; s := 38; sh := 58;
+       end;
+  else
+    Exit;
+  end;
+
+  FUpdating := True;
+  try
+    if FCam.BrightnessRange.Available then
+    begin
+      tbBrightness.Position := b;
+      lblBrightnessV.Caption := IntToStr(b);
+    end;
+    if FCam.ContrastRange.Available then
+    begin
+      tbContrast.Position := c;
+      lblContrastV.Caption := IntToStr(c);
+    end;
+    if FCam.SaturationRange.Available then
+    begin
+      tbSaturation.Position := s;
+      lblSaturationV.Caption := IntToStr(s);
+    end;
+    if FCam.SharpnessRange.Available then
+    begin
+      tbSharpness.Position := sh;
+      lblSharpnessV.Caption := IntToStr(sh);
+    end;
+    if FCam.GainRange.Available then
+    begin
+      tbGain.Position := g;
+      lblGainV.Caption := IntToStr(g);
+    end;
+    chkAutoWB.Checked := autoWB;
+    tbWBTemp.Enabled := not autoWB;
+    if not autoWB then
+    begin
+      tbWBTemp.Position := wb;
+      lblWBTempV.Caption := IntToStr(wb) + 'K';
+    end;
+    chkBacklight.Checked := backlight;
+    HighlightLook(Index);
+  finally
+    FUpdating := False;
+  end;
+
+  FCam.SetBrightness(b);
+  FCam.SetContrast(c);
+  FCam.SetSaturation(s);
+  FCam.SetSharpness(sh);
+  if FCam.GainRange.Available then
+    FCam.SetGain(g);
+  FCam.SetAutoWhiteBalance(autoWB);
+  if not autoWB then
+    FCam.SetWhiteBalanceTemp(wb);
+  FCam.SetBacklightCompensation(backlight);
+  FCam.SetAutoFocus(True);
+  FActiveLook := Index;
+  CamLog(Self, 'Look: ' + DefaultLook(Index));
+end;
+
+procedure TfrmMain.LookClick(Sender: TObject);
+begin
+  ApplyLook((Sender as TButton).Tag);
+end;
