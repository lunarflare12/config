[
  {
    "height": 36,
    "layer": "top",
    "position": "top",
    "spacing": 3,
    "modules-left": [
      "clock",
      "custom/swaync",
      "niri/workspaces",
      "tray"
    ],
    "modules-right": [
      "custom/network",
      "niri/language",
      "group/stats",
      "group/audio",
      "custom/power-menu"
    ],
    "group/stats": {
      "orientation": "horizontal",
      "modules": [
        "cpu",
        "memory",
        "disk"
      ]
    },
    "group/audio": {
      "orientation": "horizontal",
      "modules": [
        "wireplumber#icon",
        "wireplumber#sink",
        "wireplumber#source"
      ]
    },
    "wireplumber#icon": {
      "format": "{icon}",
      "format-muted": "󰖁",
      "format-icons": [
        "",
        "",
        "󰕾",
        ""
      ],
      "on-click": "pavucontrol",
      "tooltip-format": "{node_name} · {volume}%"
    },
    "wireplumber#sink": {
      "format": "{volume}%",
      "format-muted": "—",
      "scroll-step": 5,
      "max-volume": 150,
      "on-click": "~/.config/waybar/scripts/volume.sh --toggle",
      "on-click-right": "pavucontrol",
      "on-scroll-up": "swayosd-client --output-volume raise",
      "on-scroll-down": "swayosd-client --output-volume lower",
      "tooltip-format": "{node_name} · {volume}%"
    },
    "wireplumber#source": {
      "node-type": "Audio/Source",
      "format": "{volume}%",
      "format-muted": "",
      "min-length": 6,
      "max-length": 8,
      "scroll-step": 5,
      "max-volume": 150,
      "on-click": "~/.config/waybar/scripts/volume.sh --toggle-mic",
      "on-click-right": "pavucontrol",
      "on-scroll-up": "swayosd-client --input-volume raise",
      "on-scroll-down": "swayosd-client --input-volume lower",
      "tooltip-format": "{node_name} · {volume}%"
    },
    "niri/workspaces": {
      "format": "{icon}",
      "on-click": "activate",
      "format-icons": {
        "1": "",
        "2": "",
        "3": "",
        "4": "",
        "5": "",
        "6": "",
        "7": "",
        "8": "",
        "9": "",
        "magic": "",
        "urgent": "",
        "default": ""
      },
      "persistent-workspaces": {
        "*": 9
      },
      "show-special": true,
      "special-visible-only": true,
      "on-scroll-down": "niri msg action focus-workspace-down",
      "on-scroll-up": "niri msg action focus-workspace-up"
    },
    "tray": {
      "icon-size": 20,
      "spacing": 12
    },
    "clock": {
      "interval": 60,
      "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
      "format": "{:%d %b, %I:%M %p}",
      "format-alt": "{:%a %b %d, %G}"
    },
    "cpu": {
      "format": "{usage}% 󰍛",
      "interval": 2
    },
    "memory": {
      "interval": 10,
      "format": "{used:0.1f}G 󰾆",
      "format-alt": "{percentage}% 󰾆",
      "format-alt-click": "click",
      "tooltip": true,
      "tooltip-format": "{used:0.1f}GB/{total:0.1f}G"
    },
    "disk": {
      "interval": 30,
      "path": "/",
      "format": "{percentage_used}% 󰋊",
      "format-alt-click": "click",
      "format-alt": "{free} free  󰋊",
      "tooltip": true,
      "tooltip-format": "{used} used out of {total} on {path} ({percentage_used}%)"
    },
    "battery": {
      "interval": 60,
      "full-at": 100,
      "states": {
        "good": 95,
        "warning": 30,
        "critical": 15
      },
      "format": "{icon}  {capacity}%",
      "format-charging": " {capacity}%",
      "format-plugged": "  {capacity}%",
      "format-full": "{icon}  Full",
      "format-alt": "{icon}  {time}",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "format-time": "{H}h {M}min",
      "tooltip": true
    },
    "custom/network": {
      "exec": "~/.config/waybar/scripts/network.sh",
      "return-type": "json",
      "interval": 5,
      "min-length": 26,
      "max-length": 26,
      "signal": 7,
      "on-click": "~/.config/waybar/scripts/network.sh next; pkill -RTMIN+7 waybar"
    },
    "niri/language": {
      "format": "{}",
      "format-en": "En",
      "format-ru": "Ru",
      "on-click": "niri msg action switch-layout next",
      "tooltip": "Раскладка · клик: переключить"
    },
    "custom/power-menu": {
      "format": " \u23fb ",
      "on-click": "pkill wlogout || wlogout -p layer-shell -b 2",
      "tooltip": "Power menu"
    },
    "custom/swaync": {
      "tooltip": true,
      "format": "{icon} {text}",
      "format-icons": {
        "notification": "\uf0f3<span foreground='red'><sup>\uf111</sup></span>",
        "none": "\uf0f3",
        "dnd-notification": "\uf847<span foreground='red'><sup>\uf111</sup></span>",
        "dnd-none": "\uf847",
        "inhibited-notification": "\uf0f3<span foreground='red'><sup>\uf111</sup></span>",
        "inhibited-none": "\uf0f3",
        "dnd-inhibited-notification": "\uf847<span foreground='red'><sup>\uf111</sup></span>",
        "dnd-inhibited-none": "\uf847"
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "sleep 0.1 && swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true
    }
  }
]
