#!/usr/bin/env bash
set +e
# Prefer a manually rebuilt helper (e.g. after a hyprfix hotfix) until the
# next home-manager switch refreshes the profile binary.
for p in \
  "${HOME:-/home/dd}/.local/bin/aurora" \
  "/etc/profiles/per-user/${USER:-dd}/bin/aurora" \
  "/run/current-system/sw/bin/aurora"
do
  if [ -x "$p" ]; then
    exec "$p" "$@"
  fi
done
printf 'aurora: binary not found\n' >&2
exit 127
