#!/usr/bin/env python3
# Raise an already-running app (tray / MPRIS / D-Bus) instead of spawning
# a second Electron. Exit 0 = shown, 2 = process lives (caller may exec
# without splash), 1 = not running.

from __future__ import annotations

import os
import re
import subprocess
import sys

WEAK = {
    "a",
    "app",
    "applicationstatus",
    "ayatana",
    "bin",
    "com",
    "config",
    "dark",
    "desktop",
    "disable",
    "enable",
    "features",
    "force",
    "freedesktop",
    "gnome",
    "gpu",
    "gtk",
    "home",
    "icon",
    "indicator",
    "io",
    "item",
    "kde",
    "mode",
    "net",
    "nix",
    "notification",
    "notificationitem",
    "notifier",
    "org",
    "ozone",
    "platform",
    "qt",
    "sandbox",
    "scripts",
    "status",
    "statusnotifieritem",
    "store",
    "tray",
    "usr",
    "wayland",
    "www",
}

GENERIC_SNI = ("chrome_status_icon", "status_icon")


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=0.4)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 1, "", "timeout")


def norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", (s or "").lower()).strip()


def strip_wrap(s: str) -> str:
    t = (s or "").lower().lstrip(".")
    t = re.sub(r"\.(desktop|sh)$", "", t)
    t = re.sub(r"(-wrapped|-wrappe|wrapped|wrappe)$", "", t)
    return t


def tokens_of(*parts: str) -> set[str]:
    out: set[str] = set()
    for raw in parts:
        if not raw:
            continue
        low = str(raw).lower()
        out.add(strip_wrap(low.split("/")[-1]))
        for t in norm(low).split():
            t = strip_wrap(t)
            if t and t not in WEAK and not t.isdigit():
                out.add(t)
    out.discard("")
    return out


def token_hit(needle: str, hay: str) -> bool:
    n = strip_wrap(needle)
    h = strip_wrap(hay)
    if not n or not h or n in WEAK:
        return False
    if n == h:
        return True
    if len(n) >= 4 and (h.startswith(n) or (n.startswith(h) and len(h) >= 4)):
        return True
    if len(n) >= 5 and n in h:
        return True
    return False


def any_hit(needles: set[str], *hays: str) -> bool:
    for n in needles:
        for h in hays:
            if token_hit(n, h):
                return True
    return False


def bus_owners() -> dict[str, tuple[str, str]]:
    out = run(["busctl", "--user", "list"])
    owners: dict[str, tuple[str, str]] = {}
    if out.returncode != 0:
        return owners
    for line in out.stdout.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        name, pid, comm = parts[0], parts[1], parts[2].lower()
        owners[name] = (pid, comm)
    return owners


def sni_items() -> list[tuple[str, str]]:
    out = run(
        [
            "busctl",
            "--user",
            "get-property",
            "org.kde.StatusNotifierWatcher",
            "/StatusNotifierWatcher",
            "org.kde.StatusNotifierWatcher",
            "RegisteredStatusNotifierItems",
        ]
    )
    if out.returncode != 0:
        return []
    items = []
    for raw in re.findall(r'"([^"]+)"', out.stdout):
        spec = raw if raw.startswith(":") or "." in raw else ":" + raw
        if "/" not in spec:
            continue
        dest, path = spec.split("/", 1)
        items.append((dest, "/" + path))
    return items


def sni_prop(dest: str, path: str, prop: str) -> str:
    for iface in ("org.kde.StatusNotifierItem", "org.freedesktop.StatusNotifierItem"):
        out = run(["busctl", "--user", "get-property", dest, path, iface, prop])
        if out.returncode == 0 and out.stdout.strip():
            text = out.stdout.strip()
            if text.startswith("s "):
                text = text[2:].strip().strip('"')
            return text
    return ""


def sni_activate(dest: str, path: str) -> bool:
    for iface in ("org.kde.StatusNotifierItem", "org.freedesktop.StatusNotifierItem"):
        out = run(["busctl", "--user", "call", dest, path, iface, "Activate", "ii", "0", "0"])
        if out.returncode == 0:
            return True
    return False


def mpris_raise(needles: set[str], owners: dict[str, tuple[str, str]], probe: bool = False) -> bool:
    for name, (pid, comm) in owners.items():
        if not name.startswith("org.mpris.MediaPlayer2."):
            continue
        if pid in ("-", "") or not pid.isdigit():
            continue
        tail = name.rsplit(".", 1)[-1]
        if tail.startswith("chromium") or tail.startswith("instance"):
            continue
        if not any_hit(needles, tail, comm, name):
            continue
        if probe:
            return True
        out = run(
            [
                "busctl",
                "--user",
                "call",
                name,
                "/org/mpris/MediaPlayer2",
                "org.mpris.MediaPlayer2",
                "Raise",
            ]
        )
        if out.returncode == 0:
            return True
    return False


def dbus_app_activate(needles: set[str], owners: dict[str, tuple[str, str]], probe: bool = False) -> bool:
    for name, (pid, comm) in owners.items():
        if name.startswith(":"):
            continue
        if pid in ("-", "") or not pid.isdigit():
            continue
        low = name.lower()
        if low.startswith("org.mpris.") or low.startswith("org.freedesktop.") or low.startswith("org.kde."):
            continue
        if not any_hit(needles, name, name.rsplit(".", 1)[-1], comm):
            continue
        if probe:
            return True
        path = "/" + name.replace(".", "/")
        out = run(
            [
                "busctl",
                "--user",
                "call",
                name,
                path,
                "org.freedesktop.Application",
                "Activate",
                "a{sv}",
                "0",
            ]
        )
        if out.returncode == 0:
            return True
    return False


def comms() -> list[str]:
    out = run(["ps", "-u", str(os.getuid()), "-o", "comm="])
    if out.returncode != 0:
        return []
    return [strip_wrap(x.strip()) for x in out.stdout.splitlines() if x.strip()]


def process_running(needles: set[str]) -> bool:
    skip = {"chrome crashpad", "crashpad", "zygote", "bwrap", "xdg-dbus-proxy"}
    for comm in comms():
        if not comm or comm in skip:
            continue
        if any_hit(needles, comm):
            return True
    return False


def bounded_hit(hay: str, needle: str) -> bool:
    """Substring only on token boundaries — bare obs must not match obsidian."""
    h = (hay or "").lower()
    n = (needle or "").lower()
    if not h or not n or n in WEAK:
        return False
    if h == n:
        return True
    from_idx = 0
    while from_idx <= len(h):
        idx = h.find(n, from_idx)
        if idx < 0:
            return False
        before = h[idx - 1] if idx > 0 else ""
        after = h[idx + len(n)] if idx + len(n) < len(h) else ""
        edge_l = not before or not before.isalnum()
        edge_r = not after or not after.isalnum()
        if edge_l and edge_r:
            return True
        from_idx = idx + 1
    return False


def class_hit(cls: str, needle: str) -> bool:
    c = strip_wrap(cls)
    n = strip_wrap(needle)
    if not c or not n or n in WEAK or len(n) < 2:
        return False
    if c == n or bounded_hit(c, n):
        return True
    if len(n) >= 4 and len(c) >= 4 and bounded_hit(n, c):
        return True
    c_last = re.split(r"[-._]", c)[-1]
    n_last = re.split(r"[-._]", n)[-1]
    if len(c_last) >= 3 and len(n_last) >= 3 and c_last == n_last:
        return True
    return False


def hypr_clients() -> list[dict]:
    # Prefer JSON; keep timeout tight — this is the already-open fast path.
    try:
        out = subprocess.run(
            ["hyprctl", "-j", "clients"],
            capture_output=True,
            text=True,
            timeout=0.6,
        )
    except Exception:
        return []
    if out.returncode != 0 or not out.stdout.strip():
        return []
    try:
        import json

        data = json.loads(out.stdout)
        return data if isinstance(data, list) else []
    except Exception:
        return []


def hypr_focus(needles: set[str], probe: bool = False) -> bool:
    """Focus an already-mapped window. This is the real already-open check —
    tray/D-Bus miss most normal apps and used to fall through into LaunchSplash."""
    skip_cls = ("quickshell", "aurora-", "hyprland")
    best_addr = ""
    best_area = -1
    for c in hypr_clients():
        cls = str(c.get("class") or c.get("initialClass") or "").lower()
        title = str(c.get("title") or "").lower()
        if not cls or any(s in cls for s in skip_cls):
            continue
        if c.get("hidden") is True:
            continue
        hit = False
        for n in needles:
            if class_hit(cls, n):
                hit = True
                break
            if len(n) >= 5 and bounded_hit(title, n):
                hit = True
                break
        if not hit:
            continue
        size = c.get("size") or [0, 0]
        try:
            area = int(size[0] or 0) * int(size[1] or 0)
        except Exception:
            area = 0
        addr = str(c.get("address") or "")
        if not addr:
            continue
        if area < 40000 and best_area >= 40000:
            continue
        if area >= best_area:
            best_area = area
            best_addr = addr if addr.startswith("0x") else ("0x" + addr)

    if not best_addr:
        return False
    if probe:
        return True
    # Hyprland 0.56+ Lua dispatcher.
    out = run(
        [
            "hyprctl",
            "dispatch",
            f'hl.dsp.focus({{ window = "address:{best_addr}" }})',
        ]
    )
    if out.returncode == 0 and "window not found" not in (out.stderr or ""):
        return True
    # Fallback focus by class of the matched client.
    return False


def main() -> int:
    args = [a for a in sys.argv[1:] if a != "--probe"]
    probe = "--probe" in sys.argv[1:]
    needles = {strip_wrap(a) for a in args if a and strip_wrap(a) not in WEAK}
    needles.discard("")
    if not needles:
        return 1

    # Windows first — already-open apps must raise, never get a LaunchSplash.
    if hypr_focus(needles, probe):
        return 0

    owners = bus_owners()
    for dest, path in sni_items():
        sid = sni_prop(dest, path, "Id")
        title = sni_prop(dest, path, "Title")
        icon = sni_prop(dest, path, "IconName")
        pid, comm = owners.get(dest, ("", ""))
        blob = " ".join((sid, title, icon)).lower()
        electron = needles & {"cursor", "code", "code-oss", "codium", "obsidian"}
        if any(g in blob for g in GENERIC_SNI) and not title:
            if comm and any_hit(needles, comm):
                if probe or sni_activate(dest, path):
                    return 2 if electron else 0
            continue
        if any_hit(needles, sid, title, icon, comm):
            if probe or sni_activate(dest, path):
                # Electron editors expose a tray that Activate does not raise.
                # Exit 2 so the launcher execs the binary (single-instance).
                return 2 if electron else 0

    if mpris_raise(needles, owners, probe):
        return 0
    if dbus_app_activate(needles, owners, probe):
        return 0
    if process_running(needles):
        return 2
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
