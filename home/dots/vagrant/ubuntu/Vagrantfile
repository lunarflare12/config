# Three Ubuntu VMs on KVM/libvirt.
# NAT (192.168.121.x) for SSH. Extra host-only net (192.168.56.11-13).
# Do not attach guests to enp7s0 — macvtap on the uplink breaks host internet.
Vagrant.configure("2") do |config|
  config.vm.box = "alvistack/ubuntu-24.04"
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.ssh.insert_key = true

  config.vm.provider :libvirt do |lv|
    lv.driver = "kvm"
    lv.memory = 2048
    lv.cpus = 2
    lv.qemu_use_session = false
  end

  (1..3).each do |i|
    config.vm.define "ubuntu#{i}" do |node|
      node.vm.hostname = "ubuntu#{i}"
      node.vm.network :private_network, ip: "192.168.56.#{10 + i}"
    end
  end
end
